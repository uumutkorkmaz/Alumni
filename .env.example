# Copy this file to .env and change the values: cp .env.example .env
# .env is ignored by git, .env.example is committed as a template.

POSTGRES_USER=alumni
POSTGRES_PASSWORD=change_me
POSTGRES_DB=alumni

# Host ports
POSTGRES_PORT=5432
API_PORT=8000

# Connection string used by the api container (host "db" is the compose service name)
DATABASE_URL=postgresql://alumni:change_me@db:5432/alumni

# Time zone of the api container (the request log shows times in this zone)
TZ=Europe/Istanbul

# 1 = add the test-only route GET /api/debug/error, which fails on purpose (to see the 5xx guardian).
# Keep 0 anywhere real users can reach the app.
DEBUG_ROUTES=0
